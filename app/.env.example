# Build-time monetization settings. Copy to ../secrets/.env (gitignored) and build with:
#   flutter run --dart-define-from-file=../secrets/.env
#   flutter build appbundle --dart-define-from-file=../secrets/.env
#
# Prices are not set here. Google Play owns them (Play Console → Monetize →
# Products) and the app shows whatever Play returns, localized, so a price
# change needs no new build.

# Play Console product IDs. One subscription with two base plans, plus a
# one-time (in-app) product for lifetime.
PRO_SUBSCRIPTION_ID=pro
PRO_MONTHLY_PLAN=monthly
PRO_YEARLY_PLAN=yearly
PRO_LIFETIME_ID=pro_lifetime

# AdMob IDs. Leave empty to use Google's test IDs. Debug and profile builds
# always use test IDs, so tapping your own ads never risks the account.
ADMOB_APP_ID=
ADMOB_INTERSTITIAL_ID=

# When ads may show, after saving a budget, loan or subscription, importing a
# statement or changing the theme.
# Each of those actions is ad-free for its first AD_FREE_USES times (0 = none).
AD_FREE_USES=0
# At least this long between two ads, and at most this many a day.
AD_MIN_GAP_MINUTES=0
AD_MAX_PER_DAY=1000000

# The AI relay's address (relay/README.md), so More → AI assistant works out
# of the box. Leave empty to have users enter their own.
AI_RELAY_URL=

# The shared-fixes server (community/README.md): SMS formats and statement
# layouts users fixed, shared with every phone.
FIXES_URL=

# The community chat Help › Join community opens (a Telegram invite link).
# Leave empty to hide that row.
COMMUNITY_URL=https://t.me/+58MYooreRy1hMDFl

# The free plan's limits: seven budgets, and the first row of accent colors.
# Leave true; false opens them to everyone.
PRO_LIMITS=true

# The AI assistant's questions and fixes are open to everyone while this is
# false. Set true once the app is live on Google Play and Pro can be bought.
AI_NEEDS_PRO=false

# Debug builds only: act as if Pro were bought, to try every Pro feature
# (this also turns ads off). Leave false normally; ignored in release builds.
# Or pass it for one run: flutter run --dart-define=DEBUG_PRO=true
DEBUG_PRO=false

# The bot Report SMS and Report an issue send through, and its private channel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
