<?xml version="1.0" encoding="utf-8"?>
<!-- Enlarge the transparent artwork within the system-owned app icon slot.
     The launcher activity keeps its separate adaptive icon. -->
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:drawable="@drawable/ic_notification_foreground"
    android:insetLeft="-25%" android:insetTop="-25%"
    android:insetRight="-25%" android:insetBottom="-25%" />
