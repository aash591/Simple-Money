<!-- A compact icon-sized tile centred in its cell; the whole cell is the tap target. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/quick_widget" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center"
        android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_tile_scan">
        <ImageView android:src="@drawable/widget_scan" android:layout_width="24dp" android:layout_height="24dp" android:importantForAccessibility="no" />
        <TextView android:text="Scan UPI" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="3dp" android:maxLines="1" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/widget_text" />
    </LinearLayout>
</FrameLayout>
