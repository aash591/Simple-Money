{
  "format": "sms-rules-runtime",
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "rules": [
    {
      "id": "np.nabilbank.template001",
      "bankId": "np.nabilbank",
      "bankName": "Nabil Bank",
      "country": "NP",
      "senders": [
        "NABIL",
        "NABILBANK",
        "NABIL_ALERT"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "NPR": 2
        },
        "denominations": {},
        "currency": "NPR"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear Customer, Your "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has been withdrawn by NPR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ", Remarks: "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Download App: "
        },
        {
          "op": "capture_text",
          "name": "meta1",
          "maxLength": 256
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "reference": {
          "capture": "reference"
        }
      }
    },
