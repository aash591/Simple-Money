        "EBL",
        "EBL_ALERT",
        "EVEREST",
        "EVERESTBANK",
        "UJJ SH"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
