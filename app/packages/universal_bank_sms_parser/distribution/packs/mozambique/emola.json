  "rules": [
    {
      "id": "mz.emola.template001",
      "bankId": "mz.emola",
      "bankName": "eMola",
      "country": "MZ",
      "senders": [
        "EMOLA"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "MZN": 2,
          "USD": 2
        },
        "denominations": {},
        "currency": "MZN"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password",
              "código de verificação",
              "código de segurança"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Transaction ID "
        },
        {
          "op": "capture_text",
          "name": "reference",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". You transfered "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "MT to "
        },
        {
          "op": "capture_number",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ", name: "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_datetime",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Fee: "
        },
        {
          "op": "capture_number",
          "name": "meta3",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ".00MT. Your account balance is "
        },
        {
          "op": "capture_number",
          "name": "meta4",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ".45MT. Content: . In case of doubt, please call "
        },
        {
          "op": "capture_number",
          "name": "meta5",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Thank you!"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
