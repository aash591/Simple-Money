            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password",
              "رمز التحقق",
              "رمز التفعيل"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
