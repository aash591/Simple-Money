    {
      "id": "bd.bracbank.template001",
      "bankId": "bd.bracbank",
      "bankName": "BRAC Bank",
      "country": "BD",
      "senders": [
        "BRAC BANK",
        "BRACBANK",
        "BRACBNK"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "BDT": 2
        },
        "denominations": {},
        "currency": "BDT"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "atm",
      "tokens": [
        {
          "op": "match_literal",
          "value": "TK "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " withdrawn from A/C"
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " @"
        },
        {
          "op": "capture_datetime",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " from TEST MARKET ATM DHAKA BD. Balance TK "
        },
        {
          "op": "capture_number",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". BRAC Bank."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "value": "ATM Withdrawal"
        }
      }
    },
