{
  "format": "sms-rules-runtime",
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "rules": [
    {
      "id": "th.bangkok.transfer.debit",
      "bankId": "th.bangkok",
      "bankName": "Bangkok Bank",
      "country": "TH",
      "senders": [
        "BBL"
      ],
      "defaults": {
        "case": "exact",
        "digits": [
          "ascii",
          "thai"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "THB": 2
        },
        "denominations": {},
        "currency": "THB"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "BBL: โอนเงินออก "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 24
        },
        {
          "op": "match_literal",
          "value": " บาท บช "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 32
        },
        {
          "op": "match_literal",
          "value": " คงเหลือ "
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        }
      }
    }
  ],
  "senderIndex": {
    "BBL": [
      0
    ]
  },
  "categoryRules": [],
  "counterpartyRules": []
}
