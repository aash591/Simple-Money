    {
      "id": "us.oldhickorycreditunion.template001",
      "bankId": "us.oldhickorycreditunion",
      "bankName": "Old Hickory Credit Union",
      "country": "US",
      "senders": [
        "8775907589",
        "HICKORY",
        "HICKORY-A",
        "OHCU",
        "OLD HICKORY",
        "OLDHICKORY"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "USD": 2,
          "EUR": 2,
          "GBP": 2,
          "CAD": 2,
          "AED": 2,
          "THB": 2
        },
        "denominations": {},
        "currency": "USD"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "A transaction for $"
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has posted to ACCOUNT NAME (part of ACCOUNT#), which is above the $"
        },
        {
          "op": "capture_number",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " value you set."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "counterparty": {
          "value": "Account: ACCOUNT NAME"
        }
      }
    },
