  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "rules": [
    {
      "id": "us.huntingtonbank.template001",
      "bankId": "us.huntingtonbank",
      "bankName": "Huntington Bank",
      "country": "US",
      "senders": [
        "446622",
        "HUNTINGTON",
        "HUNTINGTON BANK"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "USD": 2,
          "EUR": 2,
          "GBP": 2,
          "CAD": 2,
          "AED": 2,
          "THB": 2
        },
        "denominations": {},
        "currency": "USD"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "card",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Huntington Heads Up. We processed a debit card withdrawal: $"
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". Acct CK"
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has a $"
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " bal ("
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " ET)."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
