{
  "format": "sms-rules-runtime",
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "rules": [
    {
      "id": "eg.cibegypt.template001",
      "bankId": "eg.cibegypt",
      "bankName": "CIB Egypt",
      "country": "EG",
      "senders": [
        "CIB"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "EGP": 2,
          "USD": 2,
          "JOD": 3
        },
        "denominations": {},
        "currency": "EGP"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password",
              "رمز التحقق",
              "كلمة المرور لمرة واحدة"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "card",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Your credit card ending with"
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " was charged for EGP "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_datetime",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Card available limit is EGP "
        },
        {
          "op": "capture_number",
          "name": "meta3",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". For more details, please visit "
        },
        {
          "op": "capture_text",
          "name": "meta2",
          "maxLength": 256
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
