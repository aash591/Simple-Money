{
  "format": "sms-rules-runtime",
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "rules": [
    {
      "id": "ae.livbank.template005",
      "bankId": "ae.livbank",
      "bankName": "Liv Bank",
      "country": "AE",
      "senders": [
        "LIV"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "AED": 2,
          "USD": 2,
          "EUR": 2,
          "GBP": 2,
          "THB": 2
        },
        "denominations": {},
        "currency": "AED"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password",
              "رمز التحقق",
              "كلمة المرور لمرة واحدة"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "debit",
      "channel": "card",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Purchase of AED "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " with Debit Card ending "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". Avl Balance is AED "
        },
        {
          "op": "capture_number",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
