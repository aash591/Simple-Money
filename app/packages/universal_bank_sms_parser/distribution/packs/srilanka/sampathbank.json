  "packVersion": 1,
  "rules": [
    {
      "id": "lk.sampathbank.template001",
      "bankId": "lk.sampathbank",
      "bankName": "Sampath Bank",
      "country": "LK",
      "senders": [
        "SAMPATHTXN",
        "SAMPCCTXN"
      ],
      "defaults": {
        "case": "ascii_insensitive",
        "digits": [
          "ascii"
        ],
        "decimalMark": ".",
        "grouping": "western",
        "exponents": {
          "LKR": 2,
          "USD": 2,
          "GBP": 2
        },
        "denominations": {},
        "currency": "LKR"
      },
      "requires": [
        {},
        {}
      ],
      "classifiers": [
        {
          "classification": "security",
          "when": {
            "any": [
              "your otp",
              "Your OTP",
              "otp is",
              "verification code",
              "one-time password"
            ]
          }
        },
        {
          "classification": "promotional",
          "when": {
            "any": [
              "apply now",
              "exclusive offer",
              "Exclusive offer",
              "pre-approved",
              "cashback offer"
            ]
          }
        },
        {
          "classification": "failed",
          "when": {
            "any": [
              "failed",
              "declined",
              "unsuccessful"
            ]
          }
        },
        {
          "classification": "pending",
          "when": {
            "any": [
              "pending"
            ]
          }
        },
        {
          "classification": "future",
          "when": {
            "any": [
              "will be debited",
              "Will be debited",
              "will be credited",
              "to be debited",
              "payment due"
            ]
          }
        },
        {
          "classification": "notice",
          "when": {
            "any": [
              "statement generated",
              "minimum amount due"
            ]
          }
        }
      ],
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "LKR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " credited to AC "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " for "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " - "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " To Inq Call "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Get protected -Do not Share OTP"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
