{
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "country": "US",
  "defaults": {
    "currency": "USD",
    "case": "ascii_insensitive",
    "digits": [
      "ascii"
    ],
    "decimalMark": ".",
    "grouping": "western",
    "exponents": {
      "USD": 2,
      "EUR": 2,
      "GBP": 2,
      "CAD": 2,
      "AED": 2,
      "THB": 2
    }
  },
  "classifiers": [
    {
      "classification": "security",
      "when": {
        "any": [
          "your otp",
          "Your OTP",
          "otp is",
          "verification code",
          "one-time password"
        ]
      }
    },
    {
      "classification": "promotional",
      "when": {
        "any": [
          "apply now",
          "exclusive offer",
          "Exclusive offer",
          "pre-approved",
          "cashback offer"
        ]
      }
    },
    {
      "classification": "failed",
      "when": {
        "any": [
          "failed",
          "declined",
          "unsuccessful"
        ]
      }
    },
    {
      "classification": "pending",
      "when": {
        "any": [
          "pending"
        ]
      }
    },
    {
      "classification": "future",
      "when": {
        "any": [
          "will be debited",
          "Will be debited",
          "will be credited",
          "to be debited",
          "payment due"
        ]
      }
    },
    {
      "classification": "notice",
      "when": {
        "any": [
          "statement generated",
          "minimum amount due"
        ]
      }
    }
  ],
  "banks": [
    "adelfi/rules.json",
    "charlesschwab/rules.json",
    "chase/rules.json",
    "citibank/rules.json",
    "discovercard/rules.json",
    "huntingtonbank/rules.json",
    "navyfederalcreditunion/rules.json",
    "oldhickorycreditunion/rules.json"
  ]
}
