{
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "country": "AE",
  "defaults": {
    "currency": "AED",
    "case": "ascii_insensitive",
    "digits": [
      "ascii"
    ],
    "decimalMark": ".",
    "grouping": "western",
    "exponents": {
      "AED": 2,
      "USD": 2,
      "EUR": 2,
      "GBP": 2,
      "THB": 2
    }
  },
  "classifiers": [
    {
      "classification": "security",
      "when": {
        "any": [
          "your otp",
          "Your OTP",
          "otp is",
          "verification code",
          "one-time password",
          "رمز التحقق",
          "كلمة المرور لمرة واحدة"
        ]
      }
    },
    {
      "classification": "promotional",
      "when": {
        "any": [
          "apply now",
          "exclusive offer",
          "Exclusive offer",
          "pre-approved",
          "cashback offer"
        ]
      }
    },
    {
      "classification": "failed",
      "when": {
        "any": [
          "failed",
          "declined",
          "unsuccessful"
        ]
      }
    },
    {
      "classification": "pending",
      "when": {
        "any": [
          "pending"
        ]
      }
    },
    {
      "classification": "future",
      "when": {
        "any": [
          "will be debited",
          "Will be debited",
          "will be credited",
          "to be debited",
          "payment due"
        ]
      }
    },
    {
      "classification": "notice",
      "when": {
        "any": [
          "statement generated",
          "minimum amount due"
        ]
      }
    }
  ],
  "banks": [
    "dubaifirst/rules.json",
    "emiratesislamic/rules.json",
    "emiratesnbd/rules.json",
    "firstabudhabibank/rules.json",
    "livbank/rules.json"
  ]
}
