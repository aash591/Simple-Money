          "op": "capture_number",
          "name": "meta5",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Toll-Free)."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
