    {
      "id": "et.zemenbank.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "wallet",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear Customer your account "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has been credited with ETB "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " from "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " with reference "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Your Current Balance is ETB "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Thank you for banking with Zemen Bank"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
