        {
          "op": "capture_number",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "/"
        },
        {
          "op": "capture_number",
          "name": "meta3",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Toll-Free). Bank of Abyssinia."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
