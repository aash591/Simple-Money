{
  "id": "et.zamzambank",
  "name": "ZamZam Bank",
  "senders": [
    "ZAMZAM",
    "ZAMZAM BANK",
    "ZAMZAMBANK"
  ],
  "formats": [
    {
      "id": "et.zamzambank.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear Customer, your account "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has been credited by "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " with ETB "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Your current balance is ETB "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Thank you for banking with us!"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
    {
      "id": "et.zamzambank.template002",
      "classification": "completed",
      "direction": "debit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear John Doe, your account "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has been debited with ETB "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ".0. Your current balance is ETB "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Thank you for banking with us!"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        }
      }
    }
  ]
}
