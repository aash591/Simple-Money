{
  "id": "ng.vfdmicrofinancebank",
  "name": "VFD Microfinance Bank",
  "senders": [
    "VFD"
  ],
  "formats": [
    {
      "id": "ng.vfdmicrofinancebank.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Acct: "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 3
        },
        {
          "op": "match_literal",
          "value": " Amt: N"
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " CR Date: "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Chgs: N0."
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " (COMM VAT) Desc: "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " Balance:N3,"
        },
        {
          "op": "capture_number",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4,
          "allowShort": true
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
