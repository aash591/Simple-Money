    {
      "id": "np.nepalsbibank.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Your A/c "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Credited by NPR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
