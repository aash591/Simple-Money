{
  "schemaVersion": "0.3",
  "minEngineVersion": "0.3.0",
  "packVersion": 1,
  "country": "NP",
  "defaults": {
    "currency": "NPR",
    "case": "ascii_insensitive",
    "digits": [
      "ascii"
    ],
    "decimalMark": ".",
    "grouping": "western",
    "exponents": {
      "NPR": 2
    }
  },
  "classifiers": [
    {
      "classification": "security",
      "when": {
        "any": [
          "your otp",
          "Your OTP",
          "otp is",
          "verification code",
          "one-time password"
        ]
      }
    },
    {
      "classification": "promotional",
      "when": {
        "any": [
          "apply now",
          "exclusive offer",
          "Exclusive offer",
          "pre-approved",
          "cashback offer"
        ]
      }
    },
    {
      "classification": "failed",
      "when": {
        "any": [
          "failed",
          "declined",
          "unsuccessful"
        ]
      }
    },
    {
      "classification": "pending",
      "when": {
        "any": [
          "pending"
        ]
      }
    },
    {
      "classification": "future",
      "when": {
        "any": [
          "will be debited",
          "Will be debited",
          "will be credited",
          "to be debited",
          "payment due"
        ]
      }
    },
    {
      "classification": "notice",
      "when": {
        "any": [
          "statement generated",
          "minimum amount due"
        ]
      }
    }
  ],
  "banks": [
    "citizensbank/rules.json",
    "everestbank/rules.json",
    "laxmisunrisebank/rules.json",
    "lumbinibikashbank/rules.json",
    "machchhapuchchhrebank/rules.json",
    "manjushreefinance/rules.json",
    "nabilbank/rules.json",
    "nepalbanklimited/rules.json",
    "nepalsbibank/rules.json",
    "primecommercialbank/rules.json",
    "siddharthabank/rules.json",
    "standardcharteredbanknepal/rules.json"
  ]
}
