{
  "id": "np.nepalbanklimited",
  "name": "Nepal Bank Limited",
  "senders": [
    "NBL_ALERT"
  ],
  "formats": [
    {
      "id": "np.nepalbanklimited.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear CUSTOMER_NAME,"
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 3
        },
        {
          "op": "match_literal",
          "value": " credited NPR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ","
        },
        {
          "op": "capture_text",
          "name": "reference",
          "maxLength": 256
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4,
          "allowShort": true
        },
        "reference": {
          "capture": "reference"
        }
      }
    },
    {
      "id": "np.nepalbanklimited.template002",
      "classification": "completed",
      "direction": "debit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear CUSTOMER_NAME,"
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 3
        },
        {
          "op": "match_literal",
          "value": " debited NPR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ","
        },
        {
          "op": "capture_text",
          "name": "reference",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "@VISA"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4,
          "allowShort": true
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "value": "VISA Transaction"
        }
      }
    }
  ]
}
