{
  "id": "in.pnb",
  "name": "Punjab National Bank",
  "senders": [
    "PNB",
    "PNBBNK",
    "PNBSMS",
    "PUNBN"
  ],
  "formats": [
    {
      "id": "in.pnb.template001",
      "classification": "completed",
      "direction": "debit",
      "channel": "other",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Ac "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Debited with Rs."
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ", "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Aval Bal Rs."
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " CR. Helpline "
        },
        {
          "op": "capture_number",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "/"
        },
        {
          "op": "capture_number",
          "name": "meta3",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "-PNB"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        }
      }
    },
    {
      "id": "in.pnb.template002",
      "classification": "completed",
      "direction": "debit",
      "channel": "card",
