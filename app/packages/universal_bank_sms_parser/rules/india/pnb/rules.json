        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " free txn on PNB ATM, you utilized "
        },
        {
          "op": "capture_number",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " txn. Chrgs applicable as per policy. Bal "
        },
        {
          "op": "capture_number",
          "name": "meta3",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " CR. If not done, fwd SMS to "
        },
        {
          "op": "capture_number",
          "name": "meta4",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " to block card/call "
        },
        {
          "op": "capture_number",
          "name": "meta5",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "/"
        },
        {
          "op": "capture_number",
          "name": "meta6",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "-PNB"
