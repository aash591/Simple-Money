{
  "id": "in.canara",
  "name": "Canara Bank",
  "senders": [
    "CANBNK",
    "CNRBNK"
  ],
  "formats": [
    {
      "id": "in.canara.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "An amount of INR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " has been credited to "
        },
        {
          "op": "capture_reference",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " towards RTGS by Sender "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ", IFSC "
        },
        {
          "op": "capture_reference",
          "name": "meta2",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ", Sender A/c "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ", AXIS BANK, MUMBAI BRANCH, UTR "
        },
        {
          "op": "capture_reference",
          "name": "meta3",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ", Total Avail. Bal INR "
        },
        {
          "op": "capture_number",
          "name": "meta4",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "- Canara Bank"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      },
      "defaults": {
        "grouping": "indian"
      }
    },
    {
