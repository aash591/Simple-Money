{
  "id": "in.idfc",
  "name": "IDFC FIRST Bank",
  "senders": [
    "IDFC",
    "IDFCB",
    "IDFCBK",
    "IDFCFB"
  ],
  "formats": [
    {
      "id": "in.idfc.card",
      "classification": "completed",
      "direction": "debit",
      "channel": "card",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Transaction Successful! "
        },
        {
          "op": "capture_enum",
          "name": "currency",
          "maxLength": 3,
          "values": [
            "INR",
            "USD",
            "EUR",
            "GBP"
          ]
        },
        {
          "op": "match_literal",
          "value": " "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 24
        },
        {
          "op": "match_literal",
          "value": " spent on your IDFC FIRST Bank Credit Card ending "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 32
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 100
        },
        {
          "op": "match_literal",
          "value": " on "
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        },
        "currency": {
          "capture": "currency"
        }
      },
      "defaults": {
        "exponents": {
          "USD": 2,
          "EUR": 2,
          "GBP": 2
        }
      }
    },
