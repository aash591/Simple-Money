{
  "id": "in.jana",
  "name": "Jana Small Finance Bank",
  "senders": [
    "JANABK",
    "JANASFB"
  ],
  "formats": [
    {
      "id": "in.jana.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "upi",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear Customer, Your acct "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 3
        },
        {
          "op": "match_literal",
          "value": " is credited with INR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " from "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". UPI Ref no "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " . JANA SFB"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4,
          "allowShort": true
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "capture": "party"
        }
      }
    },
    {
      "id": "in.jana.template002",
      "classification": "completed",
      "direction": "debit",
      "channel": "upi",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear Customer, Your acct "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 3
        },
        {
          "op": "match_literal",
          "value": " is debited with INR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " to "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": "@"
        },
        {
          "op": "capture_text",
          "name": "meta1",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " UPI Ref no "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " . JANA SFB"
        },
        {
          "op": "match_end"
        }
