{
  "id": "in.amazonpay",
  "name": "Amazon Pay",
  "senders": [
    "AMAZON PAY",
    "APAY",
    "JUSPAY"
  ],
  "formats": [
    {
      "id": "in.amazonpay.template001",
      "classification": "completed",
      "direction": "debit",
      "channel": "wallet",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Your Apay Wallet balance is debited for INR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Transaction Reference Number is "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " - Powered by Juspay"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "value": "Amazon Pay Transaction"
        }
      }
    },
    {
      "id": "in.amazonpay.template002",
      "classification": "completed",
      "direction": "debit",
      "channel": "wallet",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Payment of Rs "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " using Apay Balance successful at "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". Updated Balance is Rs "
        },
        {
          "op": "capture_number",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " - SMS by Juspay"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "counterparty": {
          "capture": "party"
        }
      }
    }
  ]
}
