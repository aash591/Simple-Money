{
  "id": "in.central",
  "name": "Central Bank of India",
  "senders": [
    "CBOI",
    "CENTBK",
    "CENTRALBANK"
  ],
  "formats": [
    {
      "id": "in.central.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Rs. "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ".000 credited to your A/c "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_datetime",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " through NEFT vide Ref No./XUTR/"
        },
        {
          "op": "capture_reference",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "...XX24 By."
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": "-CBoI"
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    }
  ]
}
