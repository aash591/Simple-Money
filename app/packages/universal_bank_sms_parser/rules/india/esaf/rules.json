{
  "id": "in.esaf",
  "name": "ESAF Small Finance Bank",
  "senders": [
    "ESAFSF"
  ],
  "formats": [
    {
      "id": "in.esaf.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "other",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Your ESAF Bank A/c "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 2
        },
        {
          "op": "match_literal",
          "value": " is credited with Rs."
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_text",
          "name": "meta0",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". Ref No:"
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". For disputes, call "
        },
        {
          "op": "capture_text",
          "name": "meta1",
          "maxLength": 256
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4,
          "allowShort": true
        },
        "reference": {
          "capture": "reference"
        }
      }
    },
    {
      "id": "in.esaf.template002",
      "classification": "completed",
      "direction": "debit",
      "channel": "upi",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Your ESAF Bank A/c "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64,
          "minDigits": 2
        },
        {
          "op": "match_literal",
          "value": " debited for Rs."
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on "
        },
        {
          "op": "capture_text",
          "name": "meta0",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " and credited to a/c no."
        },
        {
          "op": "capture_text",
          "name": "meta1",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ". UPI Ref No:"
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Call "
        },
        {
          "op": "capture_text",
          "name": "meta2",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " if any dispute."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4,
          "allowShort": true
        },
        "reference": {
          "capture": "reference"
        }
      }
    }
  ]
}
