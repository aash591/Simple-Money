{
  "id": "in.jiopay",
  "name": "JioPay",
  "senders": [
    "JIOPAY"
  ],
  "formats": [
    {
      "id": "in.jiopay.template001",
      "classification": "completed",
      "direction": "debit",
      "channel": "wallet",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Recharge Successful for Jio Number : "
        },
        {
          "op": "capture_number",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ". Rs. "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " paid. Transaction ID : "
        },
        {
          "op": "capture_reference",
          "name": "reference",
          "maxLength": 64
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "reference": {
          "capture": "reference"
        },
        "counterparty": {
          "value": "Jio Recharge - 9876****"
        }
      }
    },
    {
