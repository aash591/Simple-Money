{
  "id": "lk.nationalsavingsbank",
  "name": "National Savings Bank",
  "senders": [
    "NSB"
  ],
  "formats": [
    {
      "id": "lk.nationalsavingsbank.template001",
      "classification": "completed",
      "direction": "credit",
      "channel": "bankTransfer",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Dear MR MASKED NAME,LKR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Credited to your A/c "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " on DD/MM/YYYY at HH:mm.AvlBal LKR "
        },
        {
          "op": "capture_number",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": ".Transaction "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": ".Thank you for banking with us.Call Centre "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": "."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    }
  ]
}
