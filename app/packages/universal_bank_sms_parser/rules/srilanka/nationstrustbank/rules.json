{
  "id": "lk.nationstrustbank",
  "name": "Nations Trust Bank",
  "senders": [
    "NATIONSSMS"
  ],
  "formats": [
    {
      "id": "lk.nationstrustbank.template001",
      "classification": "completed",
      "direction": "debit",
      "channel": "card",
      "tokens": [
        {
          "op": "match_literal",
          "value": "Transaction Approved on your Card "
        },
        {
          "op": "capture_account",
          "name": "account",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " for LKR "
        },
        {
          "op": "capture_money",
          "name": "amount",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " at "
        },
        {
          "op": "capture_text",
          "name": "party",
          "maxLength": 256
        },
        {
          "op": "match_literal",
          "value": " Available Bal LKR "
        },
        {
          "op": "capture_number",
          "name": "meta0",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " Call "
        },
        {
          "op": "capture_number",
          "name": "meta1",
          "maxLength": 64
        },
        {
          "op": "match_literal",
          "value": " for any inquiry."
        },
        {
          "op": "match_end"
        }
      ],
      "output": {
        "amount": {
          "capture": "amount"
        },
        "accountLast4": {
          "capture": "account",
          "operation": "extract_account_suffix",
          "length": 4
        },
        "counterparty": {
          "capture": "party"
        }
      }
    }
  ]
}
