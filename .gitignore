# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/app/build/
/app/coverage/
/app/node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/app/android/app/debug
/app/android/app/profile
/app/android/app/release

# Widget Preview related
.widget_preview/

# Exported release APKs (build output)
/apkOut/

# Private, consented SMS exports for local parser diagnostics.
/artifacts/sms/

# Local libwebp binaries (cwebp/dwebp) used by the icon-export scripts.
# Download from https://storage.googleapis.com/downloads.webmproject.org/releases/webp/
/app/tool/bin/

/artifacts/recieved/

# Private SMS restore/decryption material and plaintext device snapshots.
/sms/artifacts/collector-private.der
/sms/artifacts/recieved/
/sms/artifacts/decrypted/

# Build-time settings live in secrets/.env (copy from app/.env.example).
/app/.env

# Signing keystore and certificates. Never commit.
/secrets/

# Real bank and UPI statements used while developing the importers.
/devtimefiles/
/devtimeiles/

# Raw/unprocessed assets (large binary source files).
/assets_raw/

# Community content, relay server, and SMS tooling directories.
/community/
/relay/
/sms/

/tool/

# Setup script (machine-specific, generated by SetupEnvironment.bat).
SetupEnvironment.bat
/build.cmd
/build.ps1
/.gitattributes
/.gitmodules
/.gitignore

__pycache__/
