// SimpleMoney AI relay: lets Claude, ChatGPT and other MCP apps ask the
// user's phone about their SimpleMoney data. Stores and logs no money data.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "simplemoney-ai-relay",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-01",
	// The OAuth library fetches client metadata documents; never let it reach private addresses.
	"compatibility_flags": ["global_fetch_strictly_public"],
	// Your public https address. With no custom domain, this is
	// https://simplemoney-ai-relay.<your-subdomain>.workers.dev
	"vars": { "BASE_URL": "https://simplemoney-ai-relay.aashglobal591.workers.dev" },
	// `npx wrangler kv namespace create OAUTH_KV` prints the id to put here.
	"kv_namespaces": [{ "binding": "OAUTH_KV", "id": "0882548e4fd84fc194ec7f4c5bd427cf" }],
	"durable_objects": {
		"bindings": [
			{ "name": "PHONE", "class_name": "Phone" },
			{ "name": "PAIR_CODE", "class_name": "PairCode" }
		]
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["Phone"] },
		{ "tag": "v2", "new_sqlite_classes": ["PairCode"] }
	],
	// namespace_id must be unique within your Cloudflare account.
	"ratelimits": [
		{ "name": "PAIR_LIMIT", "namespace_id": "7301", "simple": { "limit": 10, "period": 60 } },
		{ "name": "REGISTER_LIMIT", "namespace_id": "7302", "simple": { "limit": 5, "period": 60 } },
		{ "name": "MCP_LIMIT", "namespace_id": "7303", "simple": { "limit": 120, "period": 60 } }
	],
	// Request logs would record URLs and timings only, but stay off anyway.
	"observability": { "enabled": false }
}
